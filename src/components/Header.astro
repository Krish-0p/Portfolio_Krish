---
/**
 * Header — Sticky top bar.
 * Layout: logo-zone (left) → progress line (center) → nav-zone (right)
 * 78px height, frosted backdrop, 1px bottom border.
 */
---
<header class="header">
  <div class="header__inner">
    <div class="header__logo">
      <slot name="logo" />
    </div>

    <div class="header__progress">
      <div class="header__progress-track">
        <div class="header__progress-fill" id="scroll-progress"></div>
      </div>
    </div>

    <nav class="header__nav">
      <slot name="nav" />
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    width: 100%;
    height: var(--header-h);
    background: rgba(10, 10, 10, 0.55);
    backdrop-filter: var(--blur-header);
    -webkit-backdrop-filter: var(--blur-header);
    border-bottom: var(--border-subtle);
    padding: var(--space-24) var(--gutter) var(--space-20);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    width: 100%;
    height: 100%;
  }

  .header__logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .header__progress {
    flex: 1;
    min-width: var(--space-40);
    display: flex;
    align-items: center;
  }

  .header__progress-track {
    width: 100%;
    height: 1px;
    position: relative;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  .header__progress-fill {
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.08s linear;
    will-change: transform;
    /* Color applied by consumer via CSS variable or override */
    background: currentColor;
    opacity: 0.7;
  }

  .header__nav {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .header {
      padding-left: var(--space-20);
      padding-right: var(--space-20);
    }
  }
</style>

<script>
  function initScrollProgress() {
    const fill = document.getElementById('scroll-progress');
    if (!fill) return;

    function update() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(scrollTop / docHeight, 1) : 0;
      fill.style.transform = `scaleX(${progress})`;
    }

    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  document.addEventListener('DOMContentLoaded', initScrollProgress);
</script>
