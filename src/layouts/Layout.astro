---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Krish — Designer & Developer', description = 'Building interfaces that bridge ambition and execution.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Space Grotesk + JetBrains Mono + Fjalla One -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500&family=Space+Grotesk:wght@300;400;500;600;700&family=Fjalla+One&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* ══════════════════════════════════════
     KRISH DESIGN SYSTEM — CSS TOKENS
  ══════════════════════════════════════ */
  :root {
    /* Color tokens */
    --color-root: #08080C;
    --color-raised: #0E0E14;
    --color-surface: #14141C;
    --color-accent: #E8A838;
    --color-accent-soft: #F0C060;
    --color-accent-dim: rgba(232, 168, 56, 0.15);
    --color-accent-glow: rgba(232, 168, 56, 0.25);
    --color-secondary: #8B9CF7;

    /* Text opacity tokens */
    --text-primary: rgba(255, 255, 255, 0.95);
    --text-secondary: rgba(255, 255, 255, 0.60);
    --text-muted: rgba(255, 255, 255, 0.40);
    --text-ghost: rgba(255, 255, 255, 0.20);

    /* Border opacity tokens */
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-medium: rgba(255, 255, 255, 0.10);
    --border-visible: rgba(255, 255, 255, 0.16);

    /* Glass */
    --glass-bg: rgba(14, 14, 20, 0.65);

    /* Spacing scale */
    --gutter: clamp(1.5rem, 5vw, 4rem);

    /* Section heights */
    --header-h: 72px;
    --hero-min-h: min(860px, 85vh);
    --status-h: 64px;
    --work-gap: 80px;
    --ticker-h: 160px;
  }

  /* Small-viewport height: prevents the iOS/Android URL bar from overflowing the hero */
  @supports (height: 100svh) {
    :root {
      --hero-min-h: min(860px, 85svh);
    }
  }

  /* Reset & base */
  html {
    color-scheme: dark;
    /* Stop iOS Safari inflating text on orientation change */
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  /* No sideways scroll on narrow screens */
  html, body {
    overflow-x: hidden;
    max-width: 100%;
  }

  /* Lenis smooth scrolling styles */
  html.lenis, html.lenis body {
    height: auto;
  }
  .lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }
  .lenis-stopped {
    overflow: hidden;
  }
  .lenis-smooth iframe {
    pointer-events: none;
  }

  body {
    /* Notch / rounded-corner gutters (0 on every non-notched device) */
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
    -webkit-tap-highlight-color: transparent;
    background-color: var(--color-root);
    color: var(--text-primary);
    font-family: 'Fjalla One', 'Space Grotesk', system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Accessibility */
  .skip-link {
    position: fixed;
    top: -100%;
    left: 1rem;
    z-index: 9999;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-accent);
    color: var(--color-root);
    font-weight: 600;
    border-radius: 2px;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 1rem;
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Scrollbar hide utility */
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* Selection */
  ::selection {
    background-color: var(--color-accent-dim);
    color: var(--text-primary);
  }
</style>

<script>
  import Lenis from 'lenis';
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Register GSAP ScrollTrigger
  gsap.registerPlugin(ScrollTrigger);

  // Initialize Lenis smooth scroll
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    smoothWheel: true,
    wheelMultiplier: 1.0,
    touchMultiplier: 1.5,
  });

  // Keep GSAP ScrollTrigger updated with Lenis scroll events
  lenis.on('scroll', ScrollTrigger.update);

  // Integrate Lenis RAF with GSAP ticker
  gsap.ticker.add((time) => {
    lenis.raf(time * 1000);
  });

  // Disable lag smoothing to prevent visual sync issues
  gsap.ticker.lagSmoothing(0);

  // Handle internal anchor links using Lenis for smooth transitions
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const anchor = target.closest('a');
    
    if (anchor) {
      const href = anchor.getAttribute('href');
      // Check if it's an anchor link on the same page
      if (href && href.startsWith('#') && href !== '#') {
        // Skip default behavior for accessibility skip links
        if (anchor.classList.contains('skip-link')) return;

        e.preventDefault();
        const targetEl = document.querySelector(href);
        if (targetEl) {
          lenis.scrollTo(targetEl);
        }
      }
    }
  });
</script>
