---
/**
 * SectionDivider — Empty structural spacer between sections.
 * Fixed height with top and bottom 1px borders.
 */
---
<div class="section-divider" aria-hidden="true"></div>

<style>
  .section-divider {
    width: 100%;
    height: var(--divider-h);
    border-top: var(--border-medium);
    border-bottom: var(--border-medium);
  }
</style>
