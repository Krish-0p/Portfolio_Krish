---
/**
 * InfoBar — Three equal columns below the hero.
 *
 * Layout: flex:1 | flex:1 | flex:1
 * Each column is a centered stack: icon slot → label slot.
 * 1px right border between columns. Fixed height ~170px.
 * Optional background pattern slot per column.
 */
interface Props {
  columns?: number;
}
const { columns = 3 } = Astro.props;
---
<div class="infobar" role="region" aria-label="Quick info">
  <div class="infobar__col">
    <slot name="col-1" />
  </div>
  <div class="infobar__col">
    <slot name="col-2" />
  </div>
  <div class="infobar__col infobar__col--last">
    <slot name="col-3" />
  </div>
</div>

<style>
  .infobar {
    display: flex;
    width: 100%;
    height: var(--infobar-h);
    border-top: var(--border-subtle);
  }

  .infobar__col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 11px;
    position: relative;
    overflow: hidden;
    border-right: var(--border-subtle);
    padding: var(--space-16);
  }

  .infobar__col--last {
    border-right: none;
  }

  /* ── Responsive: stack on mobile ── */
  @media (max-width: 768px) {
    .infobar {
      flex-direction: column;
      height: auto;
    }

    .infobar__col {
      border-right: none;
      border-bottom: var(--border-subtle);
      padding: var(--space-24) var(--gutter);
      min-height: calc(var(--infobar-h) / 2);
    }

    .infobar__col--last {
      border-bottom: none;
    }
  }
</style>
