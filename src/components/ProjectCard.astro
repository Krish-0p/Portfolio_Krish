---
/**
 * ProjectCard — Full-width card inside the work panel.
 *
 * Layout:
 *   - Image area: full-width, fixed aspect, 1px border, overflow hidden
 *   - Metadata row below: title+description (left) ↔ date (right)
 *   - Gap between image and metadata: 20px
 *   - Gap between cards: 46px (handled by parent)
 */
---
<article class="project-card">
  <div class="project-card__image">
    <slot name="image" />
  </div>

  <div class="project-card__meta">
    <div class="project-card__info">
      <slot name="title" />
      <slot name="description" />
    </div>
    <div class="project-card__date">
      <slot name="date" />
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    width: 100%;
  }

  /* ── Image area ── */
  .project-card__image {
    width: 100%;
    height: var(--card-img-h);
    position: relative;
    overflow: hidden;
    border: var(--border-visible);
    flex-shrink: 0;
  }

  /* ── Metadata row ── */
  .project-card__meta {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    min-height: 94px;
    gap: var(--space-20);
  }

  .project-card__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: 569px;
    flex-shrink: 0;
    min-width: 0;
  }

  .project-card__date {
    flex-shrink: 0;
    white-space: nowrap;
    padding-top: 2px;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .project-card__image {
      height: clamp(240px, 50vw, var(--card-img-h));
    }

    .project-card__meta {
      flex-direction: column;
      gap: var(--space-8);
      min-height: auto;
    }

    .project-card__info {
      max-width: none;
    }
  }
</style>
