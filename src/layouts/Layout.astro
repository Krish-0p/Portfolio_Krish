---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Krish — Designer & Developer', description = 'Building interfaces that bridge ambition and execution.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Space Grotesk + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* ══════════════════════════════════════
     KRISH DESIGN SYSTEM — CSS TOKENS
  ══════════════════════════════════════ */
  :root {
    /* Color tokens */
    --color-root: #08080C;
    --color-raised: #0E0E14;
    --color-surface: #14141C;
    --color-accent: #E8A838;
    --color-accent-soft: #F0C060;
    --color-accent-dim: rgba(232, 168, 56, 0.15);
    --color-accent-glow: rgba(232, 168, 56, 0.25);
    --color-secondary: #8B9CF7;

    /* Text opacity tokens */
    --text-primary: rgba(255, 255, 255, 0.95);
    --text-secondary: rgba(255, 255, 255, 0.60);
    --text-muted: rgba(255, 255, 255, 0.40);
    --text-ghost: rgba(255, 255, 255, 0.20);

    /* Border opacity tokens */
    --border-subtle: rgba(255, 255, 255, 0.06);
    --border-medium: rgba(255, 255, 255, 0.10);
    --border-visible: rgba(255, 255, 255, 0.16);

    /* Glass */
    --glass-bg: rgba(14, 14, 20, 0.65);

    /* Spacing scale */
    --gutter: clamp(1.5rem, 5vw, 4rem);

    /* Section heights */
    --header-h: 72px;
    --hero-min-h: min(860px, 85vh);
    --status-h: 64px;
    --work-gap: 80px;
    --ticker-h: 160px;
  }

  /* Reset & base */
  html {
    scroll-behavior: smooth;
    color-scheme: dark;
  }

  body {
    background-color: var(--color-root);
    color: var(--text-primary);
    font-family: 'Space Grotesk', system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Accessibility */
  .skip-link {
    position: fixed;
    top: -100%;
    left: 1rem;
    z-index: 9999;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-accent);
    color: var(--color-root);
    font-weight: 600;
    border-radius: 2px;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 1rem;
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Scrollbar hide utility */
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  /* Selection */
  ::selection {
    background-color: var(--color-accent-dim);
    color: var(--text-primary);
  }
</style>
